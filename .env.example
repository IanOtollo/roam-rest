# Copy the names below into .env.local (never commit .env.local).
# `npm run admin:setup` fills in the ADMIN_* values for you.

# --- Convex (from your Convex dashboard) -----------------------------------------------
# The "Deployment URL" ending in .convex.cloud (the site and admin read/write through this)
NEXT_PUBLIC_CONVEX_URL=
# The "HTTP Actions URL" ending in .convex.site (only needed if you add webhooks, e.g. M-Pesa)
NEXT_PUBLIC_CONVEX_SITE_URL=
# Which deployment the Convex CLI talks to, e.g. prod:your-deployment-name
CONVEX_DEPLOYMENT=
# Deploy key: lets `npx convex deploy` publish your backend. Keep it secret. Production/CI only.
CONVEX_DEPLOY_KEY=

# --- Admin sign-in (created by `npm run admin:setup`; only hashes are stored) -----------
ADMIN_EMAIL_HASH=
ADMIN_PASSWORD_HASH=
ADMIN_EMAIL_PEPPER=
ADMIN_SESSION_SECRET=
# Shared secret between this site and Convex. Must also be set in Convex:
#   npx convex env set ADMIN_API_SECRET <the same value>
ADMIN_API_SECRET=

# --- Site -------------------------------------------------------------------------------
# Public address of the site, used for sharing previews (no trailing slash)
NEXT_PUBLIC_SITE_URL=

# --- Email (Resend) ---------------------------------------------------------------------
# Booking inquiry emails to the host. Create the key at resend.com > API keys.
RESEND_API_KEY=
# Must be on a domain verified in Resend. Until then use: Roam & Rest <onboarding@resend.dev>
RESEND_FROM=Roam & Rest <info@roamandrest.co.ke>
# Where inquiry emails go
NOTIFY_EMAIL=info@roamandrest.co.ke
